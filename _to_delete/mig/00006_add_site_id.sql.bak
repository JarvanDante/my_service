-- 多商户改造: 站点表 + 给业务表加 site_id + 复合唯一键。
-- +goose Up

-- 商户/站点表
CREATE TABLE site (
    id         bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name       varchar(64)  NOT NULL DEFAULT '',
    domain     varchar(128) NOT NULL DEFAULT '',   -- 前台 H5 域名, 中间件按 Host 匹配
    appid      varchar(64)  NOT NULL DEFAULT '',
    status     smallint     NOT NULL DEFAULT 1,     -- 1启用 0停用
    config     jsonb        NOT NULL DEFAULT '{}',
    created_at timestamptz  NOT NULL DEFAULT now(),
    updated_at timestamptz  NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uk_site_domain ON site (domain) WHERE domain <> '';
COMMENT ON TABLE site IS '商户/站点';

-- 默认站点(存量数据归属), 新表首行 id=1
INSERT INTO site (name, domain) VALUES ('默认站点', 'localhost');

-- 给业务表加 site_id(默认 1, 存量自动回填 1)
ALTER TABLE users             ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_follow       ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_code         ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_code_log     ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_sign         ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_task         ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_task_log     ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_balance_log  ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE user_share_log    ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE recharge_package  ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE recharge_order    ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE vip_package       ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE vip_log           ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE chat_conversation ADD COLUMN site_id bigint NOT NULL DEFAULT 1;
ALTER TABLE chat_message      ADD COLUMN site_id bigint NOT NULL DEFAULT 1;

-- 冲突的唯一键改成复合键(同名/同码可跨商户共存)
DROP INDEX uk_users_username;
CREATE UNIQUE INDEX uk_users_username ON users (site_id, username) WHERE deleted_at IS NULL;

DROP INDEX uk_user_code_code;
CREATE UNIQUE INDEX uk_user_code_code ON user_code (site_id, code);

-- 常用列表按 site 过滤, 建索引
CREATE INDEX idx_users_site            ON users (site_id);
CREATE INDEX idx_recharge_order_site   ON recharge_order (site_id, created_at);
CREATE INDEX idx_user_code_site        ON user_code (site_id);
CREATE INDEX idx_chat_conv_site        ON chat_conversation (site_id, user_id);

-- +goose Down
DROP INDEX IF EXISTS idx_chat_conv_site;
DROP INDEX IF EXISTS idx_user_code_site;
DROP INDEX IF EXISTS idx_recharge_order_site;
DROP INDEX IF EXISTS idx_users_site;

DROP INDEX uk_user_code_code;
CREATE UNIQUE INDEX uk_user_code_code ON user_code (code);
DROP INDEX uk_users_username;
CREATE UNIQUE INDEX uk_users_username ON users (username) WHERE deleted_at IS NULL;

ALTER TABLE chat_message      DROP COLUMN site_id;
ALTER TABLE chat_conversation DROP COLUMN site_id;
ALTER TABLE vip_log           DROP COLUMN site_id;
ALTER TABLE vip_package       DROP COLUMN site_id;
ALTER TABLE recharge_order    DROP COLUMN site_id;
ALTER TABLE recharge_package  DROP COLUMN site_id;
ALTER TABLE user_share_log    DROP COLUMN site_id;
ALTER TABLE user_balance_log  DROP COLUMN site_id;
ALTER TABLE user_task_log     DROP COLUMN site_id;
ALTER TABLE user_task         DROP COLUMN site_id;
ALTER TABLE user_sign         DROP COLUMN site_id;
ALTER TABLE user_code_log     DROP COLUMN site_id;
ALTER TABLE user_code         DROP COLUMN site_id;
ALTER TABLE user_follow       DROP COLUMN site_id;
ALTER TABLE users             DROP COLUMN site_id;

DROP TABLE IF EXISTS site;
