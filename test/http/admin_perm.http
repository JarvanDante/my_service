###############################################################################
# 后台 RBAC 权限 · e2e(权限节点 CRUD + 角色授权)
#
# 说明: 本文件原先测的是旧的 Casbin 式接口 `/backend/roles/{code}/perms`(path+method 粒度),
#       那套在「casbin_rule 和 shared/rbac 都是死代码」「动态菜单权限」两次改造后已被删除。
#       现行模型是: 权限树节点(admin_permission) + 角色持有节点 id 列表(admin_role.permissions),
#       授权动作 = 更新角色的 permissions 字段。本文件已按现行接口重写。
###############################################################################

@baseUrl = http://127.0.0.1:8000

### 1. 后台登录(超管)
POST {{baseUrl}}/backend/auth/login
Content-Type: application/json

{ "username": "admin", "password": "admin123" }

> {%
client.test("登录成功", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
});
client.global.set("adminToken", response.body.data.token);
%}

### 2. 角色列表 —— 超管可访问(perm 组), 至少含 superadmin
GET {{baseUrl}}/backend/roles
Authorization: {{adminToken}}

> {%
client.test("角色列表", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
    client.assert(response.body.data.list.length >= 1, "至少一个角色");
    var hasSuper = response.body.data.list.some(function (r) { return r.code === "superadmin"; });
    client.assert(hasSuper, "应包含 superadmin 角色");
});
%}

### 3. 权限树 —— 应有内容
GET {{baseUrl}}/backend/permissions
Authorization: {{adminToken}}

> {%
client.test("权限树", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
    client.assert(response.body.data.list.length >= 1, "权限树不应为空");
});
client.global.set("rootPermId", response.body.data.list[0].id);
%}

### 4. 新增一个权限节点(接口型: isMenu=0)
POST {{baseUrl}}/backend/permissions
Authorization: {{adminToken}}
Content-Type: application/json

{ "parentId": {{rootPermId}}, "name": "e2e临时权限", "routeUrl": "/backend/e2e-temp",
  "method": "GET", "isMenu": 0, "sort": 999, "status": 1 }

> {%
client.test("新增权限节点", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
    client.assert(response.body.data.id > 0, "应返回节点id");
});
client.global.set("permId", response.body.data.id);
%}

### 5. 权限树里能找到刚建的节点(树是嵌套的, 递归找)
GET {{baseUrl}}/backend/permissions
Authorization: {{adminToken}}

> {%
client.test("新节点入树", function () {
    var target = Number(client.global.get("permId"));
    function find(nodes) {
        for (var i = 0; i < nodes.length; i++) {
            if (nodes[i].id === target) return true;
            if (nodes[i].children && find(nodes[i].children)) return true;
        }
        return false;
    }
    client.assert(find(response.body.data.list), "权限树应包含新增节点");
});
%}

### 6. 建一个测试角色, 并授予该权限节点
POST {{baseUrl}}/backend/roles
Authorization: {{adminToken}}
Content-Type: application/json

{ "name": "e2e临时角色", "code": "e2e_tmp_role", "remark": "端到端测试用",
  "permissions": "{{permId}}" }

> {%
client.test("建角色并授权", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
});
client.global.set("roleId", response.body.data.id);
%}

### 7. 角色列表里该角色的 permissions 含刚授的节点
GET {{baseUrl}}/backend/roles
Authorization: {{adminToken}}

> {%
client.test("授权已生效", function () {
    var role = response.body.data.list.filter(function (r) { return r.code === "e2e_tmp_role"; })[0];
    client.assert(role !== undefined, "应能查到 e2e_tmp_role");
    client.assert(String(role.permissions).indexOf(String(client.global.get("permId"))) >= 0,
        "角色 permissions 应含新授的节点id, 实际: " + role.permissions);
});
%}

### 8. 回收权限(把 permissions 置空)
PUT {{baseUrl}}/backend/roles/{{roleId}}
Authorization: {{adminToken}}
Content-Type: application/json

{ "name": "e2e临时角色", "remark": "端到端测试用", "status": 1, "permissions": "" }

> {%
client.test("回收权限", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
});
%}

### 9. 确认已回收
GET {{baseUrl}}/backend/roles
Authorization: {{adminToken}}

> {%
client.test("权限已回收", function () {
    var role = response.body.data.list.filter(function (r) { return r.code === "e2e_tmp_role"; })[0];
    client.assert(role !== undefined, "角色应还在");
    client.assert(String(role.permissions).indexOf(String(client.global.get("permId"))) < 0,
        "permissions 应已不含该节点, 实际: " + role.permissions);
});
%}

### 10. 清理: 删角色
DELETE {{baseUrl}}/backend/roles/{{roleId}}
Authorization: {{adminToken}}

> {%
client.test("删角色", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
});
%}

### 11. 清理: 删权限节点
DELETE {{baseUrl}}/backend/permissions/{{permId}}
Authorization: {{adminToken}}

> {%
client.test("删权限节点", function () {
    client.assert(response.body.code === 0, "code 应为 0: " + response.body.message);
});
%}
