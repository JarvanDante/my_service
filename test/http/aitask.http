###############################################################################
# AI 生成任务 AiTask · e2e
# 前置: 迁移 00041 已应用; 且 internal/cmd/router.go 里已挂上三个注册函数 ——
#   mountFront:   aitaskmod.RegisterFront(group)
#   mountBackend: aitaskmod.RegisterCallback(group)   // 必须在**公开**分组, 与支付回调同级
#   mountBackend: aitaskmod.RegisterBackend(perm)     // 权限组
#
# 覆盖: 模板列表 / 开关关闭被拒 / 余额不足被拒 / 扣费正确 / client_token 幂等(只扣一次费)
#       任务详情 + 轮询兜底 / 回调成功 / **重复回调不重复处理** / 错误签名被拒
#       回调失败自动退款 / **重复失败回调不重复退款(余额只涨一次)** / 取消退款 + 重复取消被拒
#       每日上限 / 后台任务列表 / 人工退款 + 重复退款被拒 / 重新提交 / 模板 CRUD / 清理
#
# 用例可重复执行: 开跑先把 ai_daily_limit 顶到很大(不然第二次跑会被昨天…不, 是被本轮
# 之前跑的任务撑爆上限), 跑完恢复成 20; 自建的模板与临时配置最后都删掉。
# "排队中"的任务通过把 ai_provider 指向一个未注册的适配器来制造(供应商未接入时任务
# 保持排队中, 见 aitask/logic 的 dispatch 注释), 这样才有单子可以取消。
###############################################################################

@baseUrl = http://127.0.0.1:8000

### 1. 前台登录(固定设备号, 新用户余额为 0)
POST {{baseUrl}}/front/v1/user/login
Content-Type: application/json

{ "device_id": "e2e-aitask-001", "device_type": "ios", "device_version": "1.0" }

> {%
client.test("前台登录", function () {
    client.assert(response.body.code === 0, response.body.message);
});
client.global.set("token", response.body.data.token);
client.global.set("uid", response.body.data.user.id);
%}

### 2. 后台登录
POST {{baseUrl}}/backend/auth/login
Content-Type: application/json

{ "username": "admin", "password": "admin123" }

> {%
client.test("后台登录", function () { client.assert(response.body.code === 0, response.body.message); });
client.global.set("adminToken", response.body.data.token);
%}

### 3. 前台模板列表(公开) + 准备 md5(回调验签用, 运行器沙箱里没有 crypto, 只能自带一份)
GET {{baseUrl}}/front/v1/ai/templates

> {%
client.test("模板列表公开可读", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.list.length >= 3, "样板应有3个模板");
});
client.test("模板下发价格", function () {
    response.body.data.list.forEach(function (t) {
        client.assert(typeof t.cost_gold === "number", "模板必须带价格: " + t.name);
    });
});
// ---- 纯 JS md5(与 crypto/md5 逐位一致, 已对拍验证) ----
// 注意: 每个需要它的脚本块都要自带一份。IntelliJ HTTP Client 的 client.global
// 只能存字符串/数字, **存不了函数**, 跨脚本复用会拿到 undefined 然后调用报错。
function md5(s) {
  function ad(x, y) { var l = (x & 0xFFFF) + (y & 0xFFFF); var m = (x >> 16) + (y >> 16) + (l >> 16); return (m << 16) | (l & 0xFFFF); }
  function rl(n, c) { return (n << c) | (n >>> (32 - c)); }
  function cm(q, a, b, x, s2, t) { return ad(rl(ad(ad(a, q), ad(x, t)), s2), b); }
  function ff(a,b,c,d,x,s2,t){ return cm((b & c) | (~b & d), a, b, x, s2, t); }
  function gg(a,b,c,d,x,s2,t){ return cm((b & d) | (c & ~d), a, b, x, s2, t); }
  function hh(a,b,c,d,x,s2,t){ return cm(b ^ c ^ d, a, b, x, s2, t); }
  function ii(a,b,c,d,x,s2,t){ return cm(c ^ (b | ~d), a, b, x, s2, t); }
  function hex(n) { var o = "", j, v; for (j = 0; j <= 3; j++) { v = (n >>> (j * 8)) & 255; o += "0123456789abcdef".charAt((v >>> 4) & 15) + "0123456789abcdef".charAt(v & 15); } return o; }
  var bs = [], i, n = s.length;
  for (i = 0; i < n; i++) bs.push(s.charCodeAt(i) & 255);
  var bl = bs.length * 8;
  bs.push(0x80);
  while (bs.length % 64 !== 56) bs.push(0);
  for (i = 0; i < 8; i++) bs.push((bl / Math.pow(2, i * 8)) & 255);
  var x = [];
  for (i = 0; i < bs.length; i += 4) x.push(bs[i] | (bs[i+1] << 8) | (bs[i+2] << 16) | (bs[i+3] << 24));
  var a = 1732584193, b = -271733879, c = -1732584194, d = 271733878, k, oa, ob, oc, od;
  for (k = 0; k < x.length; k += 16) {
    oa = a; ob = b; oc = c; od = d;
    a=ff(a,b,c,d,x[k+0],7,-680876936);   d=ff(d,a,b,c,x[k+1],12,-389564586);  c=ff(c,d,a,b,x[k+2],17,606105819);   b=ff(b,c,d,a,x[k+3],22,-1044525330);
    a=ff(a,b,c,d,x[k+4],7,-176418897);   d=ff(d,a,b,c,x[k+5],12,1200080426);  c=ff(c,d,a,b,x[k+6],17,-1473231341); b=ff(b,c,d,a,x[k+7],22,-45705983);
    a=ff(a,b,c,d,x[k+8],7,1770035416);   d=ff(d,a,b,c,x[k+9],12,-1958414417); c=ff(c,d,a,b,x[k+10],17,-42063);     b=ff(b,c,d,a,x[k+11],22,-1990404162);
    a=ff(a,b,c,d,x[k+12],7,1804603682);  d=ff(d,a,b,c,x[k+13],12,-40341101);  c=ff(c,d,a,b,x[k+14],17,-1502002290);b=ff(b,c,d,a,x[k+15],22,1236535329);
    a=gg(a,b,c,d,x[k+1],5,-165796510);   d=gg(d,a,b,c,x[k+6],9,-1069501632);  c=gg(c,d,a,b,x[k+11],14,643717713);  b=gg(b,c,d,a,x[k+0],20,-373897302);
    a=gg(a,b,c,d,x[k+5],5,-701558691);   d=gg(d,a,b,c,x[k+10],9,38016083);    c=gg(c,d,a,b,x[k+15],14,-660478335); b=gg(b,c,d,a,x[k+4],20,-405537848);
    a=gg(a,b,c,d,x[k+9],5,568446438);    d=gg(d,a,b,c,x[k+14],9,-1019803690); c=gg(c,d,a,b,x[k+3],14,-187363961);  b=gg(b,c,d,a,x[k+8],20,1163531501);
    a=gg(a,b,c,d,x[k+13],5,-1444681467); d=gg(d,a,b,c,x[k+2],9,-51403784);    c=gg(c,d,a,b,x[k+7],14,1735328473);  b=gg(b,c,d,a,x[k+12],20,-1926607734);
    a=hh(a,b,c,d,x[k+5],4,-378558);      d=hh(d,a,b,c,x[k+8],11,-2022574463); c=hh(c,d,a,b,x[k+11],16,1839030562); b=hh(b,c,d,a,x[k+14],23,-35309556);
    a=hh(a,b,c,d,x[k+1],4,-1530992060);  d=hh(d,a,b,c,x[k+4],11,1272893353);  c=hh(c,d,a,b,x[k+7],16,-155497632);  b=hh(b,c,d,a,x[k+10],23,-1094730640);
    a=hh(a,b,c,d,x[k+13],4,681279174);   d=hh(d,a,b,c,x[k+0],11,-358537222);  c=hh(c,d,a,b,x[k+3],16,-722521979);  b=hh(b,c,d,a,x[k+6],23,76029189);
    a=hh(a,b,c,d,x[k+9],4,-640364487);   d=hh(d,a,b,c,x[k+12],11,-421815835); c=hh(c,d,a,b,x[k+15],16,530742520);  b=hh(b,c,d,a,x[k+2],23,-995338651);
    a=ii(a,b,c,d,x[k+0],6,-198630844);   d=ii(d,a,b,c,x[k+7],10,1126891415);  c=ii(c,d,a,b,x[k+14],15,-1416354905);b=ii(b,c,d,a,x[k+5],21,-57434055);
    a=ii(a,b,c,d,x[k+12],6,1700485571);  d=ii(d,a,b,c,x[k+3],10,-1894986606); c=ii(c,d,a,b,x[k+10],15,-1051523);   b=ii(b,c,d,a,x[k+1],21,-2054922799);
    a=ii(a,b,c,d,x[k+8],6,1873313359);   d=ii(d,a,b,c,x[k+15],10,-30611744);  c=ii(c,d,a,b,x[k+6],15,-1560198380); b=ii(b,c,d,a,x[k+13],21,1309151649);
    a=ii(a,b,c,d,x[k+4],6,-145523070);   d=ii(d,a,b,c,x[k+11],10,-1120210379);c=ii(c,d,a,b,x[k+2],15,718787259);   b=ii(b,c,d,a,x[k+9],21,-343485551);
    a = ad(a, oa); b = ad(b, ob); c = ad(c, oc); d = ad(d, od);
  }
  return hex(a) + hex(b) + hex(c) + hex(d);
}
// 本轮唯一的 client_token 前缀, 保证用例可重复执行(幂等键跨轮次不会撞车)
client.global.set("ct", "ct-" + Math.floor(Math.random() * 1000000000));
%}

### 4. 取 AI 相关配置的 id(后续要临时改开关/上限, 跑完恢复)
GET {{baseUrl}}/backend/config?keyword=ai_&page=1&size=50
Authorization: {{adminToken}}

> {%
client.test("配置可读", function () { client.assert(response.body.code === 0, response.body.message); });
var byKey = {};
response.body.data.list.forEach(function (c) { byKey[c.key] = c; });
client.test("00041 已插入运营参数", function () {
    client.assert(byKey["ai_open"], "缺 ai_open");
    client.assert(byKey["ai_default_cost"], "缺 ai_default_cost");
    client.assert(byKey["ai_daily_limit"], "缺 ai_daily_limit");
    client.assert(byKey["ai_callback_secret"], "缺 ai_callback_secret");
});
client.global.set("cfgOpenId", byKey["ai_open"].id);
client.global.set("cfgLimitId", byKey["ai_daily_limit"].id);
client.global.set("secret", JSON.parse(byKey["ai_callback_secret"].value));
%}

### 5. 把每日上限顶高(让用例可重复执行; 第 22 步会专门测上限)
PUT {{baseUrl}}/backend/config/{{cfgLimitId}}
Authorization: {{adminToken}}
Content-Type: application/json

{ "value": "100000", "status": 1 }

> {%
client.test("放开每日上限", function () { client.assert(response.body.code === 0, response.body.message); });
%}

### 6. 关闭 AI 总开关
PUT {{baseUrl}}/backend/config/{{cfgOpenId}}
Authorization: {{adminToken}}
Content-Type: application/json

{ "value": "false", "status": 1 }

> {%
client.test("关闭AI开关", function () { client.assert(response.body.code === 0, response.body.message); });
%}

### 7. 开关关闭时提交必须被拒(且不扣费)
POST {{baseUrl}}/front/v1/ai/submit
Authorization: {{token}}
Content-Type: application/json

{ "biz_type": 3, "params": { "prompt": "关掉开关不该能提交" } }

> {%
client.test("开关关闭时提交被拒", function () {
    client.assert(response.body.code !== 0, "AI关闭时不该允许提交");
});
%}

### 8. 恢复 AI 总开关
PUT {{baseUrl}}/backend/config/{{cfgOpenId}}
Authorization: {{adminToken}}
Content-Type: application/json

{ "value": "true", "status": 1 }

> {%
client.test("恢复AI开关", function () { client.assert(response.body.code === 0, response.body.message); });
%}

### 9. 后台建一个天价模板(用来测余额不足)
POST {{baseUrl}}/backend/ai/templates
Authorization: {{adminToken}}
Content-Type: application/json

{ "name": "e2e天价文生图", "biz_type": 3, "cover": "", "preview": "",
  "params": { "style": "e2e" }, "cost_gold": 999999999, "sort": 1, "status": 1 }

> {%
client.test("建天价模板", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.id > 0, "应返回模板id");
});
client.global.set("richTplId", response.body.data.id);
%}

### 10. 余额不足必须被拒(价格取服务端模板价, 客户端传什么都不作数)
POST {{baseUrl}}/front/v1/ai/submit
Authorization: {{token}}
Content-Type: application/json

{ "biz_type": 3, "template_id": {{richTplId}}, "params": { "prompt": "余额不足" }, "cost_gold": 1 }

> {%
client.test("余额不足被拒", function () {
    client.assert(response.body.code !== 0, "余额不足不该允许提交");
});
%}

### 11. 后台建一个 20 金币的 e2e 模板(后续所有提交都用它)
POST {{baseUrl}}/backend/ai/templates
Authorization: {{adminToken}}
Content-Type: application/json

{ "name": "e2e文生图", "biz_type": 3, "cover": "c.png", "preview": "p.png",
  "params": { "style": "e2e", "size": "512x512" }, "cost_gold": 20, "sort": 2, "status": 1 }

> {%
client.test("建e2e模板", function () { client.assert(response.body.code === 0, response.body.message); });
client.global.set("tplId", response.body.data.id);
%}

### 12. 后台加金币(基线余额从这里开始算)
POST {{baseUrl}}/backend/wallet/adjust
Authorization: {{adminToken}}
Content-Type: application/json

{ "user_id": {{uid}}, "amount": 500, "remark": "e2e-aitask充值" }

> {%
client.test("加金币", function () { client.assert(response.body.code === 0, response.body.message); });
client.global.set("bal0", response.body.data.balance);
%}

### 13. 提交任务: 扣费正确 + mock 立即受理(status=2 处理中)
POST {{baseUrl}}/front/v1/ai/submit
Authorization: {{token}}
Content-Type: application/json

{ "biz_type": 3, "template_id": {{tplId}}, "params": { "prompt": "一只在敲代码的猫" },
  "input_url": "https://example.com/in.png" }

> {%
client.test("提交成功", function () { client.assert(response.body.code === 0, response.body.message); });
var t = response.body.data.task;
client.test("价格取模板价", function () { client.assert(t.cost_gold === 20, "应扣20, 实际 " + t.cost_gold); });
client.test("扣费正确", function () {
    client.assert(response.body.data.balance === client.global.get("bal0") - 20,
        "余额应为 " + (client.global.get("bal0") - 20) + ", 实际 " + response.body.data.balance);
});
client.test("mock供应商已受理(处理中)", function () { client.assert(t.status === 2, "status 应为2, 实际 " + t.status); });
client.test("不下发供应商内部标识", function () {
    client.assert(t.provider === undefined && t.provider_task_id === undefined, "前台不应下发 provider 信息");
});
client.test("参数原样落库", function () { client.assert(t.params.prompt === "一只在敲代码的猫", "params 应回显"); });
client.global.set("taskA", t.id);
client.global.set("taskANo", t.task_no);
client.global.set("bal1", response.body.data.balance);
%}

### 14. client_token 幂等: 第一次提交
POST {{baseUrl}}/front/v1/ai/submit
Authorization: {{token}}
Content-Type: application/json

{ "biz_type": 3, "template_id": {{tplId}}, "params": { "prompt": "幂等测试" }, "client_token": "{{ct}}" }

> {%
client.test("幂等首提成功", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("首提扣费", function () {
    client.assert(response.body.data.balance === client.global.get("bal1") - 20,
        "应扣20, 余额 " + response.body.data.balance);
});
client.test("首提不是重复请求", function () { client.assert(response.body.data.repeated === false, "首提 repeated 应为 false"); });
client.global.set("taskB", response.body.data.task.id);
client.global.set("bal2", response.body.data.balance);
%}

### 15. client_token 幂等: 同 token 再提一次 —— 必须返回同一个任务且不再扣费
POST {{baseUrl}}/front/v1/ai/submit
Authorization: {{token}}
Content-Type: application/json

{ "biz_type": 3, "template_id": {{tplId}}, "params": { "prompt": "幂等测试重发" }, "client_token": "{{ct}}" }

> {%
client.test("重复提交仍成功(不报错)", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("返回同一个任务", function () {
    client.assert(response.body.data.task.id === client.global.get("taskB"),
        "应返回任务 " + client.global.get("taskB") + ", 实际 " + response.body.data.task.id);
});
client.test("标记为重复请求", function () { client.assert(response.body.data.repeated === true, "repeated 应为 true"); });
client.test("**没有二次扣费**", function () {
    client.assert(response.body.data.balance === client.global.get("bal2"),
        "余额应保持 " + client.global.get("bal2") + ", 实际 " + response.body.data.balance);
});
%}

### 16. 任务详情 + 轮询兜底: 处理中的任务会顺手向供应商查一次并落库(mock 返回成功)
GET {{baseUrl}}/front/v1/ai/task?id={{taskB}}
Authorization: {{token}}

> {%
client.test("查任务成功", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("轮询兜底把任务推到成功态", function () {
    client.assert(response.body.data.task.status === 3, "status 应为3(成功), 实际 " + response.body.data.task.status);
});
client.test("产物已落库", function () {
    client.assert(response.body.data.task.result && response.body.data.task.result.url, "result 应含产物地址");
});
%}

### 17. 我的任务列表(status 用 string 接收; 3=成功)
GET {{baseUrl}}/front/v1/ai/tasks?biz_type=3&status=3&page=1&size=10
Authorization: {{token}}

> {%
client.test("我的任务列表", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("按状态筛选生效", function () {
    client.assert(response.body.data.total >= 1, "至少有一条成功任务");
    response.body.data.list.forEach(function (t) { client.assert(t.status === 3, "筛出来的都应是成功态"); });
});
%}

### 18. 后台任务列表: 取 taskA 的 provider_task_id(回调要用)
GET {{baseUrl}}/backend/ai/tasks?user_id={{uid}}&task_no={{taskANo}}
Authorization: {{adminToken}}

> {%
client.test("后台任务列表", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("能查到 taskA", function () { client.assert(response.body.data.total === 1, "应恰好1条"); });
var t = response.body.data.list[0];
client.test("后台可见供应商信息", function () {
    client.assert(t.provider === "mock", "provider 应为 mock, 实际 " + t.provider);
    client.assert(t.provider_task_id.length > 0, "应有外部任务号");
});
client.global.set("ptidA", t.provider_task_id);
// 预生成成功回调的签名: sign = md5(provider_task_id + status + secret)
// ---- 纯 JS md5(与 crypto/md5 逐位一致, 已对拍验证) ----
function md5(s) {
  function ad(x, y) { var l = (x & 0xFFFF) + (y & 0xFFFF); var m = (x >> 16) + (y >> 16) + (l >> 16); return (m << 16) | (l & 0xFFFF); }
  function rl(n, c) { return (n << c) | (n >>> (32 - c)); }
  function cm(q, a, b, x, s2, t) { return ad(rl(ad(ad(a, q), ad(x, t)), s2), b); }
  function ff(a,b,c,d,x,s2,t){ return cm((b & c) | (~b & d), a, b, x, s2, t); }
  function gg(a,b,c,d,x,s2,t){ return cm((b & d) | (c & ~d), a, b, x, s2, t); }
  function hh(a,b,c,d,x,s2,t){ return cm(b ^ c ^ d, a, b, x, s2, t); }
  function ii(a,b,c,d,x,s2,t){ return cm(c ^ (b | ~d), a, b, x, s2, t); }
  function hex(n) { var o = "", j, v; for (j = 0; j <= 3; j++) { v = (n >>> (j * 8)) & 255; o += "0123456789abcdef".charAt((v >>> 4) & 15) + "0123456789abcdef".charAt(v & 15); } return o; }
  var bs = [], i, n = s.length;
  for (i = 0; i < n; i++) bs.push(s.charCodeAt(i) & 255);
  var bl = bs.length * 8;
  bs.push(0x80);
  while (bs.length % 64 !== 56) bs.push(0);
  for (i = 0; i < 8; i++) bs.push((bl / Math.pow(2, i * 8)) & 255);
  var x = [];
  for (i = 0; i < bs.length; i += 4) x.push(bs[i] | (bs[i+1] << 8) | (bs[i+2] << 16) | (bs[i+3] << 24));
  var a = 1732584193, b = -271733879, c = -1732584194, d = 271733878, k, oa, ob, oc, od;
  for (k = 0; k < x.length; k += 16) {
    oa = a; ob = b; oc = c; od = d;
