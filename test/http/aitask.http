### 37. 提交任务 → 供应商未接入, 任务停在"排队中"(钱先扣着, 不自动退, 见 dispatch 注释)
POST {{baseUrl}}/front/v1/ai/submit
Authorization: {{token}}
Content-Type: application/json

{ "biz_type": 3, "template_id": {{tplId}}, "params": { "prompt": "待取消的任务" } }

> {%
client.test("提交成功", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("供应商未接入时保持排队中", function () {
    client.assert(response.body.data.task.status === 1, "status 应为1(排队中), 实际 " + response.body.data.task.status);
});
client.test("已扣费", function () {
    client.assert(response.body.data.balance === client.global.get("balAfterRetry") - 20,
        "余额应为 " + (client.global.get("balAfterRetry") - 20) + ", 实际 " + response.body.data.balance);
});
client.global.set("taskD", response.body.data.task.id);
client.global.set("balQueued", response.body.data.balance);
%}

### 38. 取消排队中的任务 → 退款
POST {{baseUrl}}/front/v1/ai/cancel
Authorization: {{token}}
Content-Type: application/json

{ "id": {{taskD}} }

> {%
client.test("取消成功", function () { client.assert(response.body.code === 0, response.body.message); });
client.test("取消即退款", function () {
    client.assert(response.body.data.refund === 20, "应退20, 实际 " + response.body.data.refund);
    client.assert(response.body.data.balance === client.global.get("balQueued") + 20,
        "余额应为 " + (client.global.get("balQueued") + 20) + ", 实际 " + response.body.data.balance);
});
client.global.set("balAfterCancel", response.body.data.balance);
%}

### 39. **重复取消必须被拒**(条件更新, 不会退第二次)
