### 57. 清理校验: 模板已删, 样板 3 个模板原样保留
GET {{baseUrl}}/front/v1/ai/templates

> {%
client.test("清理干净", function () {
    client.assert(response.body.code === 0, response.body.message);
    var e2e = response.body.data.list.filter(function (t) { return t.name.indexOf("e2e") === 0; });
    client.assert(e2e.length === 0, "e2e模板应已删除");
    client.assert(response.body.data.list.length === 3, "样板模板应保持3个, 实际 " + response.body.data.list.length);
});
%}
