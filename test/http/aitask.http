### 19. 错误签名的回调必须被拒(否则任何人都能伪造完成/失败)
POST {{baseUrl}}/backend/ai/callback
Content-Type: application/json

{ "provider": "mock", "provider_task_id": "{{ptidA}}", "status": 3,
  "result": { "url": "https://example.com/hacked.png" }, "sign": "deadbeef" }

> {%
client.test("错误签名被拒", function () { client.assert(response.body.code !== 0, "签名错误不该被接受"); });
%}

