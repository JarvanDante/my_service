    client.assert(response.body.data.balance === client.global.get("balAfterCharge") + 20,
        "余额应退回到 " + (client.global.get("balAfterCharge") + 20) + ", 实际 " + response.body.data.balance);
});
client.global.set("balAfterRefund", response.body.data.balance);
