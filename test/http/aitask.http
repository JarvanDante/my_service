### 33. 金币流水核对: 该任务只有一条退款流水(不是两条) —— 按 ref_id(业务单号)对账
GET {{baseUrl}}/backend/balance-logs?user_id={{uid}}&scene=ai_refund&page=1&size=50
Authorization: {{adminToken}}

> {%
client.test("流水可读", function () { client.assert(response.body.code === 0, response.body.message); });
var refunds = response.body.data.list.filter(function (w) {
    return w.ref_id === client.global.get("taskCNo") && w.direction === 1;
});
client.test("退款流水有且只有一条(3次失败回调只退了1次)", function () {
    client.assert(refunds.length === 1, "应只有1条退款流水, 实际 " + refunds.length);
    client.assert(refunds[0].amount === 20, "退款金额应为20, 实际 " + refunds[0].amount);
});
%}

### 34. 后台对失败任务发起"重新提交": 重新扣费 + retry_count+1
POST {{baseUrl}}/backend/ai/tasks/{{taskC}}/retry
Authorization: {{adminToken}}
Content-Type: application/json

{}

> {%
client.test("重新提交成功", function () { client.assert(response.body.code === 0, response.body.message); });
var t = response.body.data.task;
client.test("retry_count+1", function () { client.assert(t.retry_count >= 1, "retry_count 应>=1, 实际 " + t.retry_count); });
client.test("重新受理(处理中)", function () { client.assert(t.status === 2, "status 应为2, 实际 " + t.status); });
%}

