POST {{baseUrl}}/backend/lottery/addresses/{{addrId}}/ship
Authorization: {{adminToken}}
Content-Type: application/json

{ "express_no": "SF-E2E-0001" }

> {%
client.test("后台发货", function () { client.assert(response.body.code === 0, response.body.message); });
%}

### 29. 重复发货应被拒(条件更新判定)
POST {{baseUrl}}/backend/lottery/addresses/{{addrId}}/ship
Authorization: {{adminToken}}
Content-Type: application/json

{ "express_no": "SF-E2E-0002" }

> {%
client.test("重复发货被拒", function () { client.assert(response.body.code !== 0, "应被拒"); });
%}

### 30. 中奖记录可查: 实物奖已流转为"已发货"
GET {{baseUrl}}/front/v1/lottery/my?lottery_type=1&page=1&size=20
Authorization: {{token}}

> {%
client.test("我的中奖记录", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.total === Number(client.global.get("base")) + 4,
        "本次应新增4条记录(1免费+3金币), 实际总数 " + response.body.data.total);
    var g = response.body.data.list.filter(function (h) {
        return String(h.id) === String(client.global.get("goodsHistoryId"));
    });
    client.assert(g.length === 1 && g[0].status === 3, "实物奖应已发货");
    client.assert(g[0].prize_text === "实物", "奖品类型文案");
});
%}

### 31. 跑马灯用的是真实中奖记录(实物中奖已入榜, 昵称脱敏)
GET {{baseUrl}}/front/v1/lottery/info?lottery_type=1

> {%
client.test("跑马灯为真实记录", function () {
    client.assert(response.body.code === 0, response.body.message);
    var hit = response.body.data.marquee.some(function (m) { return m.prize_name === "e2e实物周边"; });
    client.assert(hit, "跑马灯应含刚中的实物奖");
    response.body.data.marquee.forEach(function (m) {
        client.assert(m.nickname.indexOf("*") >= 0, "昵称应脱敏: " + m.nickname);
        client.assert(m.prize_type !== 5, "谢谢参与不该上跑马灯");
    });
});
%}

### 32. 后台中奖记录筛选(user_id + prize_type, 全部 string 接收)
GET {{baseUrl}}/backend/lottery/histories?user_id={{uid}}&lottery_type=1&prize_type=4&status=3&page=1&size=20
Authorization: {{adminToken}}

> {%
client.test("后台记录筛选", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.total >= 1, "实物+已发货应至少1条");
    client.assert(response.body.data.list[0].prize_name === "e2e实物周边", "最新一条应是本次实物奖");
    client.assert(String(response.body.data.list[0].id) === String(client.global.get("goodsHistoryId")), "应是本次中奖记录");
});
%}

### 33. 后台记录不带筛选参数 = 全部(空串不应变成 0 条件)
GET {{baseUrl}}/backend/lottery/histories?user_id={{uid}}&lottery_type=1&prize_type=&status=&page=1&size=50
Authorization: {{adminToken}}

> {%
client.test("空筛选=全部", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.total === Number(client.global.get("base")) + 4,
        "空筛选应返回该用户全部记录, 实际 " + response.body.data.total);
});
%}

