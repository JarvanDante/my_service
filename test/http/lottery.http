### 40. 清理: 删奖品
DELETE {{baseUrl}}/backend/lottery/prizes/{{goodsId}}
Authorization: {{adminToken}}

> {%
client.test("删实物奖", function () { client.assert(response.body.code === 0, response.body.message); });
%}

### 41. 清理: 删活动(连带删剩余奖品, 保留中奖记录作为发放凭证)
DELETE {{baseUrl}}/backend/lottery/activities/{{actId}}
Authorization: {{adminToken}}

> {%
client.test("删活动", function () { client.assert(response.body.code === 0, response.body.message); });
%}

### 42. 活动删了但中奖记录还在(资产发放凭证不可丢)
GET {{baseUrl}}/backend/lottery/histories?user_id={{uid}}&lottery_type=1&page=1&size=50
Authorization: {{adminToken}}

> {%
client.test("记录保留", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.total === Number(client.global.get("base")) + 4,
        "中奖记录应完整保留, 实际 " + response.body.data.total);
});
%}

### 43. 清理: 奖品已随活动删除
GET {{baseUrl}}/backend/lottery/prizes?activity_id={{actId}}
Authorization: {{adminToken}}

> {%
client.test("奖品已清空", function () {
    client.assert(response.body.code === 0, response.body.message);
    client.assert(response.body.data.list.length === 0, "奖品应已被连带删除");
});
%}
